# PackProof configuration
# Leave the PayPal credentials empty to run in SIM mode (faithful local
# simulator of the PayPal sandbox Disputes lifecycle — demo never dies).
# Fill them in to switch to LIVE mode against the real PayPal sandbox.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Your sandbox app must have the "Disputes" feature enabled in its options.
PAYPAL_ENV=sandbox

# auto = live when credentials exist, otherwise sim. Force with sim|live.
PACKPROOF_MODE=auto

# Optional: vision LLM endpoint (OpenAI-compatible) for production photo
# reports. The demo build uses deterministic image math + heuristics and
# does not need this.
VISION_API_BASE=
VISION_API_KEY=
VISION_MODEL=
